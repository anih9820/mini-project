    "@testing-library/jest-dom": "^5.17.0",
    "@testing-library/react": "^12.0.0",
    "babel-jest": "^27.5.1",
    "concurrently": "^6.2.1",
    "cross-env": "^7.0.3",
    "css-loader": "^7.1.2",
    "eslint": "^7.32.0",
    "eslint-config-prettier": "^8.3.0",
